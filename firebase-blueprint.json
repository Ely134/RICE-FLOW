        "isPreOrder": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["status"]
    },
    "activityLogs": {
      "title": "Activity Logs",
      "description": "System activity logs",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "category": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["category", "action"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "User and admin notifications",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["title", "message"]
    },
    "inventoryHistory": {
      "title": "Inventory History",
      "description": "Inventory restock logs",
      "properties": {
        "id": { "type": "string" },
        "productName": { "type": "string" },
        "quantityAdded": { "type": "number" },
        "date": { "type": "string" },
        "staffName": { "type": "string" }
      },
      "required": ["productName", "quantityAdded"]
    },
    "reviews": {
      "title": "Reviews",
      "description": "Verified customer product and ordering experience reviews",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "userId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "name": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "photos": { "type": "array" },
        "verifiedPurchase": { "type": "boolean" },
        "reviewType": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["rating", "comment", "orderId", "verifiedPurchase"]
    },
    "storeSettings": {
      "title": "Store Settings",
      "description": "Store configuration",
      "properties": {
        "storeName": { "type": "string" },
        "contactNumber": { "type": "string" },
        "storeAddress": { "type": "string" }
      },
      "required": []
    },
    "contactMessages": {
      "title": "Contact Messages",
      "description": "Customer contact and inquiry messages",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "subject", "message", "status", "createdAt"]
    }
  }
}
