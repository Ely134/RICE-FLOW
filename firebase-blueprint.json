{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Rice products catalog and stock inventory",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "image": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "price"]
    },
    "users": {
      "title": "Users",
      "description": "Customer user accounts",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "gender": { "type": "string" },
        "password": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "adminUsers": {
      "title": "Admin Users",
      "description": "Administrator and staff system accounts",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["email", "role"]
    },
    "customers": {
      "title": "Customers",
      "description": "Customer ledger records",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "totalSpent": { "type": "number" },
        "status": { "type": "string" },
        "isVIP": { "type": "boolean" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["email"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer order and reservation transactions",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "amountPaid": { "type": "number" },
        "remainingAmount": { "type": "number" },
